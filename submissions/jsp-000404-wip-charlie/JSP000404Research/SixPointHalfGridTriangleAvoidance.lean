import JSP000404Research.OrdinaryCriticalHalfGrid
import JSP000404Research.TriangleCriticalUnitDomination
import JSP000404Research.SixPointHalfGridFinitePeriodNoCover
import Mathlib.Tactic

/-!
# Avoidance of ALL ordinary short-triangle bad phases on a fixed half-grid

The finite half-grid pigeonhole argument provides an actual phase at which NO
q=1 ordinary critical unit-gap obstruction is active in the six-centre,
top-(n-1), five-(n-3) profile for n >= 5.

The verified local triangle-to-critical-gap refinement is *pointwise*: for
any ordinary triangle edge-direction arc of width at most 1+delta, membership
of its bad-phase interval forces a concrete ordinary critical unit-gap slot
containing precisely that phase.

Combining the two statements gives one half-grid phase simultaneously
avoiding the bad intervals of ALL such ordinary short-triangle arcs, without
assuming any infinite-real-line cover or a quantitative cover lower bound.

This is not the missing global six-source Boolean-hole payment: it does not
show that hard/soft dyadic collision deficits are paid by genuinely unreserved
resources, nor handle nonordinary projective wrap arcs.
-/

namespace JSP000404Research

/-- There is an ordinary short projective triangle-direction arc, and x lies
in its corresponding bad interval. The witnesses are *original* vertices and
actual projective edge directions, not a free abstract family of intervals. -/
def OrdinaryShortTriangleBadAt
    {V : Type*} [LinearOrder V] [Fintype V]
    {p : V → Plane}
    (hp : Function.Injective p)
    (t delta x : ℝ) : Prop :=
  ∃ L S : ℝ, ∃ i j k : V,
    ∃ hij : i ≠ j, ∃ hik : i ≠ k, ∃ hjk : j ≠ k,
      S ≤ 1 + delta ∧
      (L ≤ normalizedEdgeTheta hp t i j hij ∧
        normalizedEdgeTheta hp t i j hij ≤ L + S) ∧
      (L ≤ normalizedEdgeTheta hp t i k hik ∧
        normalizedEdgeTheta hp t i k hik ≤ L + S) ∧
      (L ≤ normalizedEdgeTheta hp t j k hjk ∧
        normalizedEdgeTheta hp t j k hjk ≤ L + S) ∧
      (arcBadLeft L S ≤ x ∧ x ≤ arcBadRight L delta)

/-- Every bad phase generated by an actual ordinary short-triangle arc
is witnessed by a concrete ordinary critical unit-gap slot at the SAME phase. -/
theorem ordinaryShortTriangleBadAt_implies_critical_unit
    {V : Type*} [LinearOrder V] [Fintype V]
    {p : V → Plane}
    {lam t delta x : ℝ}
    (hp : Function.Injective p)
    (hcap : AngleCap p lam)
    (C : ∀ v : V, CentreProjectiveCycle hp v)
    (htpos : 0 < t)
    (hlam : lam = Real.pi / t)
    (hdeltaHalf : delta < (1 : ℝ) / 2)
    (hbad : OrdinaryShortTriangleBadAt hp t delta x) :
    ∃ u : GlobalUnitGapSlot C t,
      OrdinaryCriticalUnitBadAt C t delta u x := by
  obtain ⟨L, S, i, j, k, hij, hik, hjk,
    hSTop, hijArc, hikArc, hjkArc, hx⟩ := hbad
  obtain ⟨u, _, hubad⟩ :=
    triangle_parent_bad_has_ordinary_critical_unit
      hp hcap C htpos hlam hdeltaHalf hSTop
      hij hik hjk hijArc hikArc hjkArc hx
  exact ⟨u, hubad⟩

/-- An unconditional original-geometry six-centre phase avoidance result
for n >= 5, relative to the real AngleCap and concrete centre cycles.

No phase-cover lower bound is assumed. The result is intentionally limited
to ORDINARY triangle short arcs: nothing here pays NET Boolean-hole debt. -/
theorem six_point_exists_halfGrid_phase_avoiding_all_short_triangles
    {V : Type*} [LinearOrder V] [Fintype V]
    {p : V → Plane}
    {lam t delta : ℝ} {n : ℕ}
    (hp : Function.Injective p)
    (hcap : AngleCap p lam)
    (C : ∀ i : V, CentreProjectiveCycle hp i)
    (hn4 : 4 ≤ n)
    (hn5 : 5 ≤ n)
    (hdelta0 : 0 ≤ delta)
    (hdeltaHalf : delta < (1 : ℝ) / 2)
    (ht : t = (n : ℝ) + delta)
    (hlam : lam = Real.pi / t)
    (hcard : Fintype.card V = 6)
    (top : V)
    (hTop : centreExponent (C top) t = n - 1)
    (hMin : ∀ i : V, i ≠ top →
      centreExponent (C i) t = n - 3) :
    ∃ r : Fin (2*n+1),
      ¬ OrdinaryShortTriangleBadAt hp t delta ((r.val : ℝ) / 2) := by
  obtain ⟨r, hr⟩ :=
    exists_uncovered_halfGrid_phase_of_six_point_terminal
      C hn4 hn5 hdelta0 hdeltaHalf ht hcard top hTop hMin
  refine ⟨r, ?_⟩
  intro hbad
  have htpos : 0 < t :=
    sendov_scale_pos (by omega : 1 ≤ n) hdelta0 ht
  obtain ⟨u, hu⟩ :=
    ordinaryShortTriangleBadAt_implies_critical_unit
      hp hcap C htpos hlam hdeltaHalf hbad
  exact hr u hu

/-- For ALL 0 <= delta < 1/2 (including delta=0), there is a REAL
phase INSIDE the physical half-open normalized period [0,t) that avoids
every ordinary short-triangle bad interval.

Uses the unconditional finite-period *actual* unit-slot no-cover theorem,
not an assumed measure/length lower bound. Ordinary and wrap/mixed-rigid
debt are still fundamentally different from true Boolean holes. -/
theorem six_point_exists_finite_period_phase_avoiding_all_short_triangles
    {V : Type*} [LinearOrder V] [Fintype V]
    {p : V → Plane}
    {lam t delta : ℝ} {n : ℕ}
    (hp : Function.Injective p)
    (hcap : AngleCap p lam)
    (C : ∀ i : V, CentreProjectiveCycle hp i)
    (hn4 : 4 ≤ n)
    (hn5 : 5 ≤ n)
    (hdelta0 : 0 ≤ delta)
    (hdeltaHalf : delta < (1 : ℝ) / 2)
    (ht : t = (n : ℝ) + delta)
    (hlam : lam = Real.pi / t)
    (hcard : Fintype.card V = 6)
    (top : V)
    (hTop : centreExponent (C top) t = n - 1)
    (hMin : ∀ i : V, i ≠ top →
      centreExponent (C i) t = n - 3) :
    ∃ x : ℝ,
      0 ≤ x ∧ x < t ∧
      ¬ OrdinaryShortTriangleBadAt hp t delta x := by
  classical
  by_contra hnone
  have hall :
      ∀ x : ℝ, 0 ≤ x → x < t →
        OrdinaryShortTriangleBadAt hp t delta x := by
    intro x hx0 hxt
    by_contra hbad
    exact hnone ⟨x, hx0, hxt, hbad⟩
  have htpos : 0 < t :=
    sendov_scale_pos (by omega : 1 ≤ n) hdelta0 ht
  have hcrit :
      FinitePeriodCovers t
        (OrdinaryCriticalUnitBadAt C t delta)
        (Finset.univ : Finset (GlobalUnitGapSlot C t)) := by
    intro x hx0 hxt
    obtain ⟨u, hu⟩ :=
      ordinaryShortTriangleBadAt_implies_critical_unit
        hp hcap C htpos hlam hdeltaHalf (hall x hx0 hxt)
    exact ⟨u, Finset.mem_univ u, hu⟩
  exact
    (no_six_point_ordinary_critical_finite_period_cover
      C hn4 hn5 hdelta0 hdeltaHalf ht
      hcard top hTop hMin Finset.univ) hcrit

#print axioms six_point_exists_finite_period_phase_avoiding_all_short_triangles

#print axioms ordinaryShortTriangleBadAt_implies_critical_unit
#print axioms six_point_exists_halfGrid_phase_avoiding_all_short_triangles

end JSP000404Research
